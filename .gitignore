# Credentials — never commit tokens
.env
.env.*
*.token
*token*.json
.xurl/

# Node-local auto-publish state (scripts/watch-and-publish.sh)
.watch-published.list

# Media artifacts (upload via xurl, don't version large binaries)
*.mp4
*.mov
*.png
*.jpg
*.jpeg
*.gif

# Exception: thread videos may be versioned if small (videos/README.md)
!videos/*.mp4
!videos/*.gif

# OS / editor noise
.DS_Store
*.swp
